<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>odyssey</groupId>
	<artifactId>spring-ai-odyssey</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>spring-ai-odyssey</name>
	<description> A hands-on guide to Spring AI Usage and hands-on lab</description>


	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>


	<properties>
		<java.version>25</java.version>
	</properties>

	<!-- The BOM pins every Spring AI artifact to one consistent version.
       Because of it, the starters  carries no <version> tag.  -->

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>2.0.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>

	</dependencyManagement>

	<dependencies>

		<!-- REST endpoints, so every iteration can be driven from a browser
         or curl without writing a client. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Brings in the Anthropic model AND the auto-configuration that
         creates the ChatClient.Builder bean we inject in the chat
         package. Swapping this one line for another model starter is
         the whole "portable across providers" story. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-anthropic</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
		</dependency>
		
		<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

	</dependencies>
	
	<build>
	<plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
            <excludes>
                <exclude>application-local.yml</exclude>
                <exclude>*-local.yml</exclude>
                </excludes>
            </configuration>
        </plugin>
    </plugins>
	</build>


</project>